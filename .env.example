# --- Ollama (local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SEC=300
# Keep context/output small for 16 GB RAM, CPU-only
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1500
OLLAMA_TEMPERATURE=0.2

# --- Generation ---
MAX_REQ_CHARS_PER_CALL=1800
MAX_TESTS_PER_REQUIREMENT=12

# --- Google Drive input (details live in drive_config.yaml) ---
DRIVE_CONFIG_PATH=drive_config.yaml

# --- Misc ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
